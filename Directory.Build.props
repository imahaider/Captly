<Project>

  <PropertyGroup>
    <CaptlyPortableTfm>net10.0</CaptlyPortableTfm>
    <CaptlyWindowsTfm>net10.0-windows10.0.22621.0</CaptlyWindowsTfm>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Product>Captly</Product>
  </PropertyGroup>

</Project>
