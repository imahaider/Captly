<!-- Default templates for the custom controls. Colours are DynamicResource tokens throughout, so a
     theme applies to any subtree, which is how the gallery shows light and dark side by side. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:c="clr-namespace:Captly.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Captly.UI;component/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- CaptlyWindow -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Close.Hover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:CaptlyWindow">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Base}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:CaptlyWindow">
                    <Grid x:Name="PART_Root" Background="{TemplateBinding Background}">
                        <AdornerDecorator>
                            <ContentPresenter />
                        </AdornerDecorator>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <Button x:Name="PART_Minimize" Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="Minimize" />
                            <Button x:Name="PART_Maximize" Style="{StaticResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="Maximize" />
                            <Button x:Name="PART_Close" Style="{StaticResource CloseButton}" Content="&#xE8BB;" AutomationProperties.Name="Close" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDialog" Value="True">
                            <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small parts -->
    <Style TargetType="c:Badge">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Badge">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Success.TextBg}" />
                <Setter Property="Foreground" Value="{DynamicResource Success.Text}" />
            </Trigger>
            <Trigger Property="Variant" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Info.BadgeBg}" />
                <Setter Property="Foreground" Value="{DynamicResource Info.Badge}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="c:Keycap">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Keycap">
                    <Border MinWidth="24" Height="24" Padding="7,0" Background="{DynamicResource Bg.Card}"
                            BorderBrush="{DynamicResource Border.Control}" BorderThickness="1,1,1,2" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:FooterNote">
        <Setter Property="Margin" Value="2,2,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:FooterNote">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:Icon Size="13" VerticalAlignment="Center" Data="{TemplateBinding Icon}" Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Description}" Text="{TemplateBinding Text}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleSwitch -->
    <Style TargetType="c:ToggleSwitch">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border Margin="-4" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="16" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ToggleSwitch">
                    <Grid Background="Transparent">
                        <Border Background="{DynamicResource Toggle.Off}" CornerRadius="14" />
                        <Border x:Name="PART_Fill" Background="{DynamicResource Accent}" CornerRadius="14" Opacity="0" />
                        <Ellipse x:Name="PART_Knob" Margin="2" HorizontalAlignment="Left" Fill="{DynamicResource Toggle.Knob}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Direction="270" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MacCheckBox -->
    <Style TargetType="c:MacCheckBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:MacCheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="3" />
                            <c:Icon x:Name="Tick" HorizontalAlignment="Center" VerticalAlignment="Center" Size="12" Data="{StaticResource Icon.Check}"
                                    Foreground="{DynamicResource OnAccent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ColorSwatch -->
    <Style TargetType="c:ColorSwatch">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ColorSwatch">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="Hidden" />
                        <Ellipse Width="22" Height="22" Fill="{TemplateBinding Color}" Stroke="{DynamicResource Border.Control}" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SegmentedControl -->
    <Style TargetType="c:SegmentedItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SegmentedItem">
                    <Border x:Name="Segment" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Bg.SegmentSelected}" />
                            <Setter TargetName="Segment" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.18" Direction="270" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SegmentedControl">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SegmentedControl">
                    <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="8" Padding="2">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MacSelect -->
    <Style TargetType="c:MacSelectItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:MacSelectItem">
                    <Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:MacSelect">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:MacSelect">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Face" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="6">
                                        <c:Icon Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Size="13"
                                                Data="{StaticResource Icon.ChevronDown}" Foreground="{DynamicResource Text.Primary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Bg.Subtle}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,10,12" Padding="4" Background="{DynamicResource Bg.Card}"
                                    BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.2" Direction="270" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MacSlider -->
    <ControlTemplate x:Key="SliderFill" TargetType="RepeatButton">
        <Border Background="Transparent">
            <Border Height="7" Background="{DynamicResource Accent}" CornerRadius="3.5,0,0,3.5" />
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="SliderRest" TargetType="RepeatButton">
        <Border Background="Transparent">
            <Border Height="7" Background="{DynamicResource Border.Hairline}" BorderBrush="{DynamicResource Border.Control}"
                    BorderThickness="0,1,1,1" CornerRadius="0,3.5,3.5,0" />
        </Border>
    </ControlTemplate>

    <Style TargetType="c:MacSlider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:MacSlider">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SmallA" Margin="0,0,24,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Text="A" Visibility="Collapsed" />
                        <Track x:Name="PART_Track" Grid.Column="1" Height="20">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Template="{StaticResource SliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Template="{StaticResource SliderRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" Width="15" Height="15">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource Accent}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <TextBlock x:Name="LargeA" Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="17" Foreground="{DynamicResource Text.Secondary}" Text="A" Visibility="Collapsed" />
                        <TextBlock x:Name="Value" Grid.Column="3" MinWidth="34" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="12" TextAlignment="Right"
                                   Foreground="{DynamicResource Text.Secondary}" Text="{TemplateBinding ValueText}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowSizeLabels" Value="True">
                            <Setter TargetName="SmallA" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LargeA" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ValueFormat" Value="{x:Null}">
                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupCard and SettingRow -->
    <Style TargetType="c:GroupCardItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:GroupCardItem">
                    <Grid>
                        <ContentPresenter />
                        <Border x:Name="Separator" Height="1" VerticalAlignment="Top" Background="{DynamicResource Border.Hairline}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowSeparator" Value="True">
                            <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:GroupCard">
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:GroupCard">
                    <StackPanel>
                        <Grid x:Name="Heading" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{TemplateBinding Header}" />
                                <TextBlock x:Name="Detail" Margin="8,0,0,0" VerticalAlignment="Bottom" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="{TemplateBinding HeaderDetail}" />
                            </StackPanel>
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Content="{TemplateBinding HeaderAction}" />
                        </Grid>
                        <TextBlock x:Name="About" Margin="0,-6,0,14" Style="{StaticResource Text.Description}" Text="{TemplateBinding Description}" />
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" CornerRadius="10">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HeaderDetail" Value="{x:Null}">
                            <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="About" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SettingRow">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingRow">
                    <Grid Background="Transparent">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LabelColumn" Width="*" />
                                <ColumnDefinition x:Name="ControlColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.RowLabel}" Text="{TemplateBinding Label}" TextWrapping="Wrap" />
                                <TextBlock x:Name="Detail" Margin="0,2,0,0" Style="{StaticResource Text.Description}" Text="{TemplateBinding Description}" />
                            </StackPanel>
                            <ContentPresenter x:Name="Control" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsWide" Value="True">
                            <Setter TargetName="LabelColumn" Property="Width" Value="170" />
                            <Setter TargetName="ControlColumn" Property="Width" Value="*" />
                            <Setter TargetName="Control" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasDescription" Value="True">
                <Setter Property="Padding" Value="14,12" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- AppSourceRow -->
    <Style TargetType="c:AppSourceRow">
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AppSourceRow">
                    <Grid x:Name="Row" Background="Transparent">
                        <Grid Margin="14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioRim" Stroke="{DynamicResource Border.Control}" StrokeThickness="1.25" Fill="{DynamicResource Bg.Card}" />
                                <Ellipse x:Name="RadioDot" Width="10" Height="10" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                            </Grid>
                            <Border Grid.Column="1" Width="32" Height="32" Margin="12,0,12,0" Background="{DynamicResource Bg.Subtle}" CornerRadius="8">
                                <Image Width="20" Height="20" Source="{TemplateBinding AppIcon}" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.RowLabel}" Text="{TemplateBinding AppName}" TextTrimming="CharacterEllipsis" />
                                    <c:Badge x:Name="Playing" Margin="8,0,0,0" Variant="Success" Content="Now playing" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="Sub" Margin="0,2,0,0" Style="{StaticResource Text.Description}" Text="{TemplateBinding Subtitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                            <c:LevelMeter x:Name="Meter" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Level="{TemplateBinding Level}"
                                          Active="{DynamicResource Success}" Idle="{DynamicResource Toggle.Off}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioRim" Property="Stroke" Value="{DynamicResource Accent}" />
                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsNowPlaying" Value="True">
                            <Setter TargetName="Playing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowMeter" Value="False">
                            <Setter TargetName="Meter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CaptionBubble -->
    <Style TargetType="c:CaptionBubble">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:CaptionBubble">
                    <Border x:Name="PART_Box">
                        <c:OutlinedText x:Name="PART_Text" Text="{TemplateBinding Text}" FontFamily="{DynamicResource Font.Base}" FontSize="{TemplateBinding FontSize}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StylePresetCard -->
    <Style TargetType="c:StylePresetCard">
        <Setter Property="Height" Value="76" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StylePresetCard">
                    <Border x:Name="Card" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" CornerRadius="10" Padding="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="Chip" Width="30" Height="20" Background="Black" CornerRadius="2">
                                <TextBlock x:Name="ChipText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Text="Aa" />
                            </Border>
                            <ContentPresenter x:Name="Name" Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Preset" Value="Glass">
                            <Setter TargetName="Chip" Property="Background" Value="#A8121216" />
                            <Setter TargetName="Chip" Property="CornerRadius" Value="5" />
                        </Trigger>
                        <Trigger Property="Preset" Value="Outline">
                            <Setter TargetName="Chip" Property="Background" Value="#8E8E93" />
                            <Setter TargetName="ChipText" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="1" Color="Black" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Preset" Value="HighContrast">
                            <Setter TargetName="ChipText" Property="Foreground" Value="#FFD60A" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Card" Property="Padding" Value="0" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ChoiceCard -->
    <Style TargetType="c:ChoiceCard">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ChoiceCard">
                    <Border x:Name="Card" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="1" CornerRadius="10" Padding="13">
                        <StackPanel>
                            <ContentPresenter Content="{TemplateBinding Preview}" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.GroupHeader}" Text="{TemplateBinding Title}" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Description}" Text="{TemplateBinding Description}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Card" Property="Padding" Value="12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ShortcutRecorder -->
    <Style TargetType="c:ShortcutRecorder">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ShortcutRecorder">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <TextBlock x:Name="Note" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="{TemplateBinding Message}" />
                        <ItemsControl x:Name="Caps" Focusable="False" ItemsSource="{TemplateBinding Keycaps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:Keycap Margin="4,0,0,0" Content="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="Prompt" Height="31" Padding="13,0" Background="{DynamicResource Info.BadgeBg}" BorderBrush="{DynamicResource Accent}"
                                BorderThickness="1.5" CornerRadius="7" Visibility="Collapsed">
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Accent.Text}" Text="Press the new keys…" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRecording" Value="True">
                            <Setter TargetName="Caps" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Prompt" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ModelRow -->
    <Style TargetType="c:ModelRow">
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ModelRow">
                    <Grid Margin="14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Status" Stroke="{DynamicResource Border.Control}" StrokeThickness="1" />
                            <c:Icon x:Name="Tick" HorizontalAlignment="Center" VerticalAlignment="Center" Size="13" Data="{StaticResource Icon.Check}"
                                    Foreground="{DynamicResource OnAccent}" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel>
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Text.RowLabel}" Text="{TemplateBinding ModelName}" />
                                <c:Badge Margin="0,0,8,0" Content="{TemplateBinding Parameters}" />
                                <c:Badge x:Name="Recommended" Variant="Info" Content="Recommended for this PC" Visibility="Collapsed" />
                            </WrapPanel>
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Description}" Text="{TemplateBinding Description}" />
                        </StackPanel>
                        <Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="InUse" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Success.Text}" Text="In use" Visibility="Collapsed" />
                            <Button x:Name="PART_Download" Style="{StaticResource PillButton}" Content="Download" Visibility="Collapsed" />
                            <Button x:Name="PART_Use" Style="{StaticResource PillButton}" Content="Use" Visibility="Collapsed" />
                            <c:ProgressRing x:Name="Ring" Width="22" Height="22" Value="{TemplateBinding Progress}" Foreground="{DynamicResource Accent}"
                                            Track="{DynamicResource Bg.Subtle}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Available">
                            <Setter TargetName="PART_Download" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Downloading">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Installed">
                            <Setter TargetName="PART_Use" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="InUse">
                            <Setter TargetName="InUse" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Status" Property="Fill" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Status" Property="Stroke" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsRecommended" Value="True">
                            <Setter TargetName="Recommended" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SettingsShell -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding NavTitle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Item" Background="Transparent" CornerRadius="7" Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Tile" Width="22" Height="22" Background="{Binding TileBrush}" CornerRadius="6">
                                <c:Icon x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Size="14" Data="{Binding Icon}" Foreground="White" />
                            </Border>
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Text="{Binding NavTitle}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Bg.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Tile" Property="Background" Value="White" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{Binding TileBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPinned}" Value="False">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeaderChevron" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Bg.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="Search settings" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <TextBlock x:Name="Hint" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" IsHitTestVisible="False" Text="Search" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SettingsShell">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingsShell">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Sidebar" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="0,0,1,0" Padding="10,0,10,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Height="47" Margin="6,0,0,3" Orientation="Horizontal">
                                    <c:AppTile Size="16" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="Captly Settings" />
                                </StackPanel>
                                <TextBox DockPanel.Dock="Top" Margin="0,0,0,14" Style="{StaticResource SearchBox}"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ListBox Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                                         AutomationProperties.Name="Settings sections"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Pages, RelativeSource={RelativeSource TemplatedParent}}"
                                         SelectedItem="{Binding SelectedPage, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <DockPanel LastChildFill="False" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <DockPanel Grid.Column="1" Background="{DynamicResource Bg.Window}">
                            <Border DockPanel.Dock="Top" Height="53" Padding="24,0" BorderBrush="{DynamicResource Border.Hairline}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PART_Back" Style="{StaticResource HeaderChevron}" AutomationProperties.Name="Back">
                                        <c:Icon Data="{StaticResource Icon.ChevronLeft}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button x:Name="PART_Forward" Style="{StaticResource HeaderChevron}" AutomationProperties.Name="Forward">
                                        <c:Icon Data="{StaticResource Icon.ChevronRight}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.WindowTitle}"
                                               Text="{Binding SelectedPage.Title, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ContentPresenter Margin="28,20" Content="{Binding SelectedPage.Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMicaActive, RelativeSource={RelativeSource AncestorType=c:CaptlyWindow}}" Value="True">
                            <Setter TargetName="Sidebar" Property="Background" Value="{DynamicResource Bg.SidebarGlass}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
