<!-- The same keys as Light.xaml, mapped to the system's high contrast colours. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg.Window" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Bg.Sidebar" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Bg.SidebarGlass" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Bg.Card" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Bg.Subtle" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Bg.Hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Bg.SegmentSelected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Border.Hairline" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Border.Control" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Accent.Text" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Success" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Success.Text" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Success.TextBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Info.Badge" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Info.BadgeBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Close.Hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Toggle.Off" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Toggle.Knob" Color="{x:Static SystemColors.WindowTextColor}" />
</ResourceDictionary>
