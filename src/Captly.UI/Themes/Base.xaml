<!-- Theme-independent resources. Colours come from the token dictionaries through DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Captly.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Captly.UI;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Captly.UI;component/Themes/CaptlyLogo.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="Font.Base">pack://application:,,,/Captly.UI;component/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Typography, §6.1 -->
    <Style x:Key="Text.WindowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Text.GroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Text.RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Text.Description" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.SetupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!-- Focus ring: 2 px accent, 2 px offset -->
    <Style x:Key="Focus.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="9" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <ControlTemplate x:Key="Button.Template" TargetType="Button">
        <Grid>
            <Border x:Name="Face"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding (c:Shape.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="Tint" Background="Transparent"
                    CornerRadius="{Binding (c:Shape.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Bg.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Bg.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- White on accent has to stay readable while hovered, so this swaps the fill rather than tinting it. -->
    <ControlTemplate x:Key="PrimaryButton.Template" TargetType="Button">
        <Grid>
            <Border x:Name="Face" Background="{TemplateBinding Background}"
                    CornerRadius="{Binding (c:Shape.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Base}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="c:Shape.CornerRadius" Value="7" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource PrimaryButton.Template}" />
    </Style>
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
        <Setter Property="c:Shape.CornerRadius" Value="14" />
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
        <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style x:Key="PrimaryButton.Setup" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="c:Shape.CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SecondaryButton.Setup" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="c:Shape.CornerRadius" Value="8" />
    </Style>

    <!-- Slim scrollbar, for all scrolling content -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Margin="2,0" Background="{DynamicResource Border.Control}" CornerRadius="2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
